# Supabase (configurar en Vercel Dashboard > Settings > Environment Variables)
VITE_SUPABASE_URL=https://bkvfjnwglqfjlsivdttt.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Groq API (solo en backend - NO exponer al frontend). Fallback de visión OCR.
GROQ_API_KEY=tu-groq-api-key-aqui
# Opcional: sobrescribir modelos de visión Groq (coma-separados)
# GROQ_VISION_MODEL=qwen/qwen3.6-27b,qwen/qwen3.8-27b

# Gemini API (solo en backend - NO exponer al frontend).
# Motor PRIMARIO de OCR para informes ORL manuscritos (Gemini Flash Vision).
GEMINI_API_KEY=tu-gemini-api-key-aqui
# Modelo de visión (default: gemini-2.0-flash; alternativa: gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Cloudflare Workers AI (solo en backend - NO exponer al frontend)
CLOUDFLARE_ACCOUNT_ID=tu-cloudflare-account-id
CLOUDFLARE_API_TOKEN=tu-cloudflare-api-token
# Modelo de imagen (default: FLUX.1 Schnell, alta coherencia anatómica).
# Alternativas: @cf/bytedance/stable-diffusion-xl-lightning (rápido, menos preciso),
# @cf/stabilityai/stable-diffusion-xl-base-1.0 (lento, máxima calidad + prompt negativo)
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Estilo global de imágenes: realista (default, clínico fotorrealista) o lineart
ESTILO_IMAGEN=realista

# ─── Canva: DISCONTINUADO ─────────────────────────────────────────────
# La integración Canva Connect exigía cuenta Enterprise (403) y rompía el flujo.
# Se concentra todo en los motores internos: reportlab_vector y html_pdf.
# Podés borrar CANVA_CLIENT_ID / CANVA_CLIENT_SECRET de Render.

# ─── Figma REST API & Node Export ─────────────────────────────────────
FIGMA_ACCESS_TOKEN=tu-figma-access-token-aquí
FIGMA_FILE_KEY=tu-figma-file-key-aquí
FIGMA_NODE_ID=tu-figma-node-id-máster-aquí

# ─── WhatsApp Cloud API (Meta, envío directo de PDF) ────────────────────
WHATSAPP_TOKEN=tu-whatsapp-token-aqui
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id-aqui
WHATSAPP_API_VERSION=v25.0

# ─── Vocalis Companion (sesiones offline + evolución) ───────────────────
# Proveedor IA para borradores de anamnesis: groq|gemini (default: gemini)
AI_PROVIDER=gemini
# Modelo (default: gemini-2.0-flash, confirmado en repo; GLM/flash vigente va aquí)
AI_MODEL=gemini-2.0-flash
# false = no se envía audio a proveedores externos (solo métricas/segmentos)
AI_EXTERNAL_AUDIO_ENABLED=true
# Telegram SOLO saliente: notifica sesión procesada (iniciales + link, sin datos clínicos)
TELEGRAM_BOT_TOKEN=tu-bot-token-aqui
TELEGRAM_NOTIFY_CHAT_ID=tu-chat-id-aqui
# Inbound (recibir audios) apagado por defecto; al activar exige secret + DNI en caption
TELEGRAM_INBOUND_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-aleatorio
# Retención de audios en días (default 10 años). Purga SOLO manual con confirmación.
AUDIO_RETENTION_DAYS=3650
# Cuota de Storage para audios (default 1 GB, plan gratis Supabase)
STORAGE_QUOTA_BYTES=1000000000
# Firma de informes (sin leyenda "especialista en voz")
PROFESIONAL_NOMBRE=Matías Perez
PROFESIONAL_MATRICULA=M.P. 7276
# Si se fija, solo ese google_id opera (profesional único). Vacío = como hoy.
PROFESIONAL_GOOGLE_ID=
# Worker de procesamiento (hilo in-process). Desactivar solo si hay worker externo.
COMPANION_WORKER_ENABLED=true
# URL pública del frontend (links de Telegram)
FRONTEND_URL=https://vocalis-lab.vercel.app
