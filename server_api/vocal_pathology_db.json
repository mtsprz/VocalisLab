  "clinical_interpretation_rules": {
    "high_jitter_high_shimmer": {
      "pattern": "Jitter y Shimmer elevados simultáneamente",
      "possible_etiologies": ["Lesión orgánica (nodo, pólipio)", "Edema de Reinkes", "Laringitis crónica"],
      "clinical_suggestion": "Evaluar lesión estructural mediante nasolaringoscopía. Correlacionar con GRBAS G≥2."
    },
    "low_hnr_low_cpps": {
      "pattern": "HNR y CPPS disminuidos",
      "possible_etiologies": ["Escape de aire glótico", "Parálisis de cuerda vocal", "Fisura glótica posterior"],
      "clinical_suggestion": "Evaluar competencia glótica. Buscar componente de breathiness en GRBAS B≥1."
    },
    "high_jitter_normal_shimmer": {
      "pattern": "Jitter elevado con Shimmer normal",
      "possible_etiologies": ["Tensión muscular", "Nodo bilateral pequeño", "Disfonía espasmódica"],
      "clinical_suggestion": "Evaluar patrón de tensión. Considerar videolaringoestroboscopia."
    },
    "normal_jitter_high_shimmer": {
      "pattern": "Shimmer elevado con Jitter normal",
      "possible_etiologies": ["Lesión de masa (pólipo)", "Edema localizado", "Trauma vocal agudo"],
      "clinical_suggestion": "Buscar lesión unilateral. Evaluar consistencia del tono en la tarea de sostenido."
    },
    "very_low_f0_female": {
      "pattern": "F0 muy grave en mujer",
      "possible_etiologies": ["Edema de Reinkes", "Presbifonia avanzada", "Uso hormonal"],
      "clinical_suggestion": "Evaluar extensión de edema. Considerar antecedentes hormonales."
    },
    "very_high_f0_male": {
      "pattern": "F0 muy agudo en hombre",
      "possible_etiologies": ["Tensión muscular severa", "Disfonía espasmódica", "Uso de voz en registro falso"],
      "clinical_suggestion": "Evaluar registro fonatorio habitual. Buscar signos de espasmo."
    },
    "grbas_acoustic_mismatch": {
      "pattern": "Inconsistencia entre percepción (GRBAS) y acústica",
      "possible_etiologies": ["Factores psicogénicos", "Fatiga vocal intermitente", "Hiperfunción compensatoria"],
      "clinical_suggestion": "Considerar evaluación fonoaudiológica integral con énfasis en patrón respiratorio y tensión corporal."
    }
  }
}
