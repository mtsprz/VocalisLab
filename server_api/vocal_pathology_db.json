  "pathology_profiles": {
    "nodo_cordial": {
      "name": "Nodo Cordal",
      "description": "Lesión benigna de masa en el borde libre de las cuerdas vocales",
      "acoustic_pattern": {
        "f0_tendency": "ligeramente_elevada_o_normal",
        "jitter": "leve_a_moderado_aumento",
        "shimmer": "leve_a_moderado_aumento",
        "hnr": "disminuido",
        "cpps": "disminuido",
        "spectral_tilt": "empinado",
        "formants": "pueden estar alterados por la masa"
      },
      "expected_grbas": {"G": [1, 2], "R": [1, 2], "B": [0, 1], "A": [0, 1], "S": [0, 1]},
      "clinical_notes": "La presencia de una masa interpone una interferencia en la vibración mucosa, generando irregularidades cíclicas y aperiódicas."
    },
    "polipo_vocal": {
      "name": "Pólipo Vocal",
      "description": "Lesión benigna pediculada o sésil, generalmente unilateral",
      "acoustic_pattern": {
        "f0_tendency": "puede estar_normal_o_ligeramente_disminuida",
        "jitter": "aumento_moderado",
        "shimmer": "aumento_moderado_a_severo",
        "hnr": "disminuido_moderado",
        "cpps": "disminuido",
        "spectral_tilt": "empinado",
        "formants": "alterados por la masa"
      },
      "expected_grbas": {"G": [2, 3], "R": [1, 2], "B": [1, 2], "A": [0, 1], "S": [0, 1]},
      "clinical_notes": "El pólipo genera una vibración asimétrica con componente de ruido predominante. La evaluación perceptual suele mostrar ronquedad."
    },
    "edema_reinkes": {
      "name": "Edema de Reinkes",
      "description": "Acumulación de líquido en la capa de Reinke (lámina propria superficial)",
      "acoustic_pattern": {
        "f0_tendency": "disminuida",
        "jitter": "leve_aumento",
        "shimmer": "aumento_leve",
        "hnr": "leve_disminución",
        "cpps": "leve_disminución",
        "spectral_tilt": "menos_empinado_que_nodo",
        "formants": "pueden estar_normalizados"
      },
      "expected_grbas": {"G": [1, 2], "R": [1, 2], "B": [1, 2], "A": [0, 1], "S": [0, 1]},
      "clinical_notes": "El edema de Reinke produce una voz de tono grave ('voz de fumador') con componente de breathiness por cierre incompleto."
    },
    "paralisis_cuerda_vocal": {
      "name": "Parálisis de Cuerda Vocal",
      "description": "Inmovilidad de una o ambas cuerdas vocales por lesión del nervio laríngeo recurrente o superior",
      "acoustic_pattern": {
        "f0_tendency": "disminuida_o_inestable",
        "jitter": "aumento_moderado_a_severo",
        "shimmer": "aumento_severo",
        "hnr": "severamente_disminuido",
        "cpps": "severamente_disminuido",
        "spectral_tilt": "muy_empinado",
        "formants": "pueden estar_alterados",
        "voice_breaks": "frecuentes"
      },
      "expected_grbas": {"G": [2, 3], "R": [1, 3], "B": [2, 3], "A": [1, 3], "S": [1, 2]},
      "clinical_notes": "La incompletitud del cierre glótico genera fuga de aire y componente de ruido predominante. Puede haber aspiración de saliva."
    },
    "disfoniaespasmodica": {
      "name": "Disfonía Espasmódica",
      "description": "Trastorno distónico focal que afecta los músculos intrínsecos de la laringe",
      "acoustic_pattern": {
        "f0_tendency": "inestable_con_cambios_bruscos",
        "jitter": "altamente_variable",
        "shimmer": "altamente_variable",
        "hnr": "variable",
        "cpps": "variable",
        "spectral_tilt": "inestable",
        "formants": "inestables"
      },
      "expected_grbas": {"G": [2, 3], "R": [0, 1], "B": [0, 1], "A": [0, 1], "S": [0, 2]},
      "clinical_notes": "Los espasmos laringeos generan interrupciones bruscas del flujo fonatorio. La voz puede sonar normal entre episodios."
    },
    "laringitis_cronica": {
      "name": "Laringitis Crónica / Edema Vocal",
      "description": "Inflamación crónica de las cuerdas vocales por reflujo, irritación o hábitos vocales",
      "acoustic_pattern": {
        "f0_tendency": "normal_o_ligeramente_disminuida",
        "jitter": "leve_aumento",
        "shimmer": "leve_aumento",
        "hnr": "leve_disminución",
        "cpps": "leve_disminución",
        "spectral_tilt": "ligeramente_empinado"
      },
      "expected_grbas": {"G": [1, 2], "R": [0, 1], "B": [0, 1], "A": [0, 1], "S": [0, 1]},
      "clinical_notes": "El edema crónico engrosa la mucosa y afecta la onda mucosa. Generalmente responde a tratamiento conservador."
    },
    "presbifonia": {
      "name": "Presbifonia",
      "description": "Cambios vocales asociados al envejecimiento de la laringe",
      "acoustic_pattern": {
        "f0_tendency": "aumento_en_mujeres_disminucion_en_hombres",
        "jitter": "aumento_leve",
        "shimmer": "aumento_leve",
        "hnr": "leve_disminución",
        "cpps": "leve_disminución",
        "spectral_tilt": "ligeramente_empinado"
      },
      "expected_grbas": {"G": [1, 2], "R": [0, 1], "B": [1, 2], "A": [0, 1], "S": [0, 1]},
      "clinical_notes": "La atrofia muscular y la rigidez tisular reducen la excursión vibratoria y aumentan la fuga de aire."
    },
    "tension_muscular": {
      "name": "Disfonía por Tensión Muscular",
      "description": "Uso inadecuado de los músculos extrínsecos de la laringe durante la fonación",
      "acoustic_pattern": {
        "f0_tendency": "puede_elevarse_o_ser_inestable",
        "jitter": "aumento_leve_a_moderado",
        "shimmer": "normal_o_leve_aumento",
        "hnr": "leve_disminución",
        "cpps": "normal_o_leve_disminución",
        "spectral_tilt": "normal_o_ligeramente_empinado"
      },
      "expected_grbas": {"G": [1, 2], "R": [0, 1], "B": [0, 1], "A": [0, 1], "S": [0, 1]},
      "clinical_notes": "La hiperfunción muscular genera tensión en el margen vocal y puede confundirse con un nodo en estadio temprano."
    }
  },
